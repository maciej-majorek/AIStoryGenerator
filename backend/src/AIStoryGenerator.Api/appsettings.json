{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AIStoryGenerator": "Information"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",
  "StoryGeneration": {
    "DefaultProvider": "LocalMock",
    "RequestTimeoutSeconds": 30,
    "MaxConcurrentRequests": 10
  },
  "AiProviders": {
    "OpenAI": {
      "ApiKey": "${OPENAI_API_KEY}",
      "Model": "gpt-3.5-turbo",
      "MaxTokens": 2000
    },
    "Anthropic": {
      "ApiKey": "${ANTHROPIC_API_KEY}",
      "Model": "claude-3-opus",
      "MaxTokens": 2000
    }
  }
}
